 };
 
 static struct mdp_readback_slot rb_slot[MAX_RB_SLOT_NUM];
@@ -137,6 +138,64 @@ static u64 alloc_slot[SLOT_GROUP_NUM];
 static u64 alloc_slot_group;
 static DEFINE_MUTEX(rb_slot_list_mutex);
 
+/*
+ * mp3-harness: CVE-2022-20052 (MTK ALPS05836642, use after free of a readback slot).
+ * A job that reads back into a slot pins it until the job's handle is destroyed, so the slot's
+ * DRAM can't be freed (and reused) while the hardware may still write to it.
+ */
+#define MDP_RB_MAX_REF 100000
+
+static void mdp_rb_slots_init(struct cmdqRecStruct *handle)
+{
+	u32 i;
+
+	for (i = 0; i < ARRAY_SIZE(handle->slot_ids); i++)
+		handle->slot_ids[i] = -1;
+}
+
+static s32 mdp_rb_slot_get(struct cmdqRecStruct *handle, u32 readback_id)
+{
+	u32 slot_id = readback_id >> SLOT_ID_SHIFT, j;
+	s32 ret = -EINVAL;
+
+	if (slot_id >= MAX_RB_SLOT_NUM)
+		return -EINVAL;
+	mutex_lock(&rb_slot_list_mutex);
+	for (j = 0; j < ARRAY_SIZE(handle->slot_ids); j++) {
+		if (handle->slot_ids[j] == slot_id) {
+			ret = 0;
+			break;
+		}
+		if (handle->slot_ids[j] == -1) {
+			if (rb_slot[slot_id].ref_cnt >= MDP_RB_MAX_REF)
+				break;
+			handle->slot_ids[j] = slot_id;
+			rb_slot[slot_id].ref_cnt++;
+			ret = 0;
+			break;
+		}
+	}
+	mutex_unlock(&rb_slot_list_mutex);
+	if (ret)
+		CMDQ_ERR("%s cannot pin readback slot %u\n", __func__, slot_id);
+	return ret;
+}
+
+static void mdp_task_destroy(struct cmdqRecStruct *handle)
+{
+	u32 i;
+
+	mutex_lock(&rb_slot_list_mutex);
+	for (i = 0; i < ARRAY_SIZE(handle->slot_ids); i++) {
+		if (handle->slot_ids[i] >= 0 && handle->slot_ids[i] < MAX_RB_SLOT_NUM &&
+		    rb_slot[handle->slot_ids[i]].ref_cnt)
+			rb_slot[handle->slot_ids[i]].ref_cnt--;
+		handle->slot_ids[i] = -1;
+	}
+	mutex_unlock(&rb_slot_list_mutex);
+	cmdq_task_destroy(handle);
+}
